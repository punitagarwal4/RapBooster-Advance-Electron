{
  "name": "rapbooster-advance",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp marketing desktop application",
  "author": "Punit",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "next dev renderer -p 3000",
    "dev:electron": "wait-on tcp:127.0.0.1:3000 && electron-vite dev",
    "build": "npm run typecheck && npm run build:renderer && electron-vite build",
    "build:renderer": "next build renderer && node scripts/copy-renderer.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "pack": "npm run build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p renderer/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test",
    "test:smoke": "npm run pack && node scripts/smoke.mjs",
    "postinstall": "prisma generate && electron-builder install-app-deps"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "baileys": "7.0.0-rc13",
    "better-sqlite3": "12.11.1",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "libphonenumber-js": "1.13.9",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-virtual": "3.14.8",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "clsx": "^2.1.1",
    "concurrently": "10.0.4",
    "date-fns": "4.4.0",
    "electron": "42.7.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "postcss": "8.5.23",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.2.4",
    "wait-on": "9.1.0"
  }
}
